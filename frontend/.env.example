# Same Supabase project as the backend -- Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the FastAPI backend is running.
VITE_API_BASE_URL=http://localhost:8000

# Optional: error tracking. Leave empty and nothing is sent anywhere.
# Sentry -> a React project -> its DSN (looks like https://<key>@o<id>.ingest.sentry.io/<id>).
# Set it in Vercel too (Settings -> Environment Variables), then redeploy.
VITE_SENTRY_DSN=
