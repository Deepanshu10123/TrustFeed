# Copy this file to .env and fill in your own keys. Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://app.tavily.com (free tier: ~1,000 searches/month)
TAVILY_API_KEY=

# Create a free Redis database at https://upstash.com, then build:
#   rediss://default:<token>@<endpoint>:6379
# from that database's Details page (Endpoint + Token, TLS enabled -> rediss).
REDIS_URL=

# Create a free project at https://supabase.com. All three values are on
# Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed once there's a deployed frontend to allow (e.g. Vercel).
# Comma-separated if there's more than one. Leave blank for local dev --
# it falls back to the Vite dev server origins automatically.
FRONTEND_ORIGIN=

# Optional: how many different people must report a post before it's taken
# out of the feed. Defaults to 3 when unset.
# REPORT_HIDE_THRESHOLD=3

# Optional: minutes a post can sit in "processing" before it's treated as
# lost and marked failed (its owner can then try again). Defaults to 10.
# STUCK_POST_MINUTES=10

# Optional upload guardrails (free-tier friendly defaults shown):
# MAX_VIDEO_MB=50        # largest video accepted -- the free Supabase plan's per-file limit
# DAILY_VIDEO_LIMIT=5    # videos one person can upload in 24 hours
# DAILY_POST_LIMIT=20    # posts of any kind one person can make in 24 hours
